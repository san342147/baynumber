# Copy to .env and replace every example secret before use.
BAYNUMBER_DB=./data/baynumber.db
BAYNUMBER_SESSION_SECRET=replace-with-a-long-random-string-at-least-32-characters
BAYNUMBER_ADMIN_USER=secretary
BAYNUMBER_ADMIN_PASSWORD=replace-with-a-long-admin-password
BAYNUMBER_GUARD_USER=guard
BAYNUMBER_GUARD_PASSWORD=replace-with-a-long-guard-password
# Set to true when served behind HTTPS.
BAYNUMBER_SECURE_COOKIE=false
